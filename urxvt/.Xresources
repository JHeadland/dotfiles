Xcursor.theme: DMZ-White

URxvt.font: xft:DejaVu Sans Mono:pixelsize=16
URxvt.boldFont: xft:DejaVu Sans Mono:pixelsize=16:bold
URxvt.italicFont: xft:DejaVu Sans Mono:pixelsize=16:italic
URxvt.boldItalicFont: xft:DejaVu Sans Mono:pixelsize=16:bold:italic
URxvt.letterSpace: -1

!*background: #232C31
*background: #141021
*foreground: #C5C8C6
! black
*color0: #2D3C46
*color8: #425059
! red
*color1: #A54242
*color9: #CC6666
! green
*color2: #8C9440
*color10: #B5BD68
! yellow
*color3: #DE935F
*color11: #F0C674
! blue
*color4: #5F819D
*color12: #81A2BE
! magenta
*color5: #85678F
*color13: #B294BB
! cyan
*color6: #5E8D87
*color14: #8ABEB7
! white
*color7:       #c4b7c5
*color15:      #ffeefc

URxvt.internalBorder: 0
URxvt.externalBorder: 0

URxvt.scrollBar: false
URxvt*cursorBlink: true
URxvt*allow_bold: true

URxvt*fading: 30

URxvt.perl-ext-common: default,matcher,resize-font

URxvt.url-launcher: /usr/bin/chromium
URxvt.keysym.M-Delete: perl:matcher:list
URxvt.colorUL: #7780a1
URxvt.url-launcher: /usr/bin/xdg-open
URxvt.matcher.button: 1
