[bar/main]

;------------;
; DIMENSIONS ;
;------------;

width = 100%
height = 30
offset-y = 0
offset-x = 0
line-size = 2

;----------;
; LOCATION ;
;----------;

bottom = true
monitor = eDP1
override-redirect = false

;-------;
; FONTS ;
;-------;

font-0 = "Iosevka Nerd Font:size=13;2"
font-1 = "Hack Nerd Font:style=Solid:pixelsize=13;3"
font-2 = "Hack Nerd Font:style=Regular:pixelsize=13;3"
font-3 = "SauceCodePro Nerd Font:pixelsize=13;3"
font-4 = "Font Awesome 5 Free:style=Solid:pixelsize=13;3"
font-5 = "Font Awesome 5 Free:style=Regular:pixelsize=13;3"

;--------;
; COLORS ;
;--------;

; semi-transparent, set to 0 for full transparency
background = #cc000000
; #c5a9f9
foreground = #ffffff
border-color = 0

;---------------;
; MISCELLANEOUS ;
;---------------;

fixed-center = true
padding-left = 1
padding-right = 1
module-margin = 1

modules-left = arch i3
modules-center = spotify mpd
modules-right = pulseaudio xbacklight battery cpu temperature network date

tray-position = right

;---------;
; MODULES ;
;---------;

[module/arch]
type = custom/text
content = 
;content-padding = 1
content-foreground = #1793d0

[module/i3]
type = internal/i3

ws-icon-0 = 1;1
ws-icon-1 = 2;2
ws-icon-2 = 3;3
ws-icon-3 = 4;4
ws-icon-4 = 5;5
ws-icon-5 = 6;6
ws-icon-6 = 7;7
ws-icon-7 = 8;8
ws-icon-8 = 9;9

pin-workspaces = false
strip-wsnumbers = false
enable-scroll = false
enable-click = true

label-focused = %icon%
label-focused-foreground = #69f1eb
label-focused-background = #b3000000
label-focused-padding = 1
label-focused-underline = #43b581

label-unfocused = %icon%
;label-unfocused-foreground = #9d9d9d
label-unfocused-padding = 1

label-urgent = %icon%
label-urgent-foreground = #ff0000
label-urgent-underline = #a54242

label-separator = " "

;==========================================================;

[module/pulseaudio]
type = internal/pulseaudio

format-volume = <ramp-volume> <label-volume>
format-volume-underline = #1793d0
format-muted = 婢 MUTED
format-muted-underline = #cc6666

ramp-volume-0 = 奄
ramp-volume-1 = 奔
ramp-volume-2 = 墳

;==========================================================;

[module/xbacklight]
type = internal/xbacklight

; Use the following command to list available cards:
; $ ls -1 /sys/class/backlight/
card = intel_backlight

format = <ramp> <label>
format-underline = #1793d0

label = %percentage%%

ramp-0 = 
ramp-1 = 
ramp-2 = 
ramp-3 = 

;==========================================================;

[module/battery]
type = internal/battery

battery = BAT0
adapter = AC

poll-interval = 1

full-at = 100

label-discharging = %percentage%%
label-charging = %percentage%% (%time%)
label-full = %percentage%%

format-discharging = <ramp-capacity> <label-discharging>
format-discharging-underline = #1793d0
format-full = <ramp-capacity> <label-full>
format-charging = <animation-charging> <label-charging>
format-charging-underline = #f0c674

time-format = %H:%M

ramp-capacity-0 = 
ramp-capacity-1 = 
ramp-capacity-2 = 
ramp-capacity-3 = 
ramp-capacity-4 = 

animation-charging-0 = ""
animation-charging-1 = ""
animation-charging-2 = ""
animation-charging-3 = ""
animation-charging-4 = ""
animation-charging-5 = ""
animation-charging-framerate = 750

;==========================================================;

[module/cpu]
type = internal/cpu
label =  %percentage:2%%
format-underline = #1793d0

;==========================================================;

[module/temperature]
type = internal/temperature

label =  %temperature-c%
format-underline = #1793d0
format-warn-underline = #cc6666

;==========================================================;

[module/network]
type = internal/network

interface = wlan0
interval = 5
label-connected = 直 %essid%
label-disconnected = 睊
;label-connected = "%{A1:networkmanager_dmenu &:}直 %essid%%{A}"
format-connected-underline = #1793d0
;label-disconnected = "%{A1:networkmanager_dmenu &:}睊 Disconnected%{A}"
format-disconnected-underline = #cc6666

;==========================================================;

[module/date]
type = internal/date
date =   %a %b %d  %H:%M
label = %date%
format-underline = #1793d0

;==========================================================;

[module/spotify]
type = custom/script
exec = ~/.config/polybar/spotify.sh   %artist% - %title%
tail = true
interval = 2
click-left = playerctl play-pause
click-middle = playerctl previous
click-right = playerctl next

[module/mpd]
type = internal/mpd

host = 127.0.0.1
port = 6600

format-online = <icon-prev> <icon-stop> <toggle> <icon-next>  <label-song>

icon-prev = 
icon-stop = 
icon-play = 
icon-pause = 
icon-next = 
icon-random = 
icon-repeat = 

label-song-maxlen = 35
label-song-ellipsis = true

bar-progress-width = 35
bar-progress-format = %{A4:mpdseek+2: A5:mpdseek-2:}%fill%%indicator%%empty%%{A A}
bar-progress-indicator = |
bar-progress-indicator-foreground = #ff
bar-progress-indicator-font = 3
bar-progress-fill = ─
bar-progress-fill-foreground = #bb
bar-progress-fill-font = 3
bar-progress-empty = ─
bar-progress-empty-font = 3
bar-progress-empty-foreground = #44
